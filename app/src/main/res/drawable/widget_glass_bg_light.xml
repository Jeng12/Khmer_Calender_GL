<?xml version="1.0" encoding="utf-8"?>
<!-- Light frosted-glass card. Translucent so the wallpaper bleeds through, but
     bright enough that the dark brown/gold text stays legible. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="22dp" />
    <gradient
        android:angle="135"
        android:startColor="#E6FFFFFF"
        android:endColor="#CCFAF5EE" />
    <stroke
        android:width="1dp"
        android:color="#4DC8973A" />
</shape>

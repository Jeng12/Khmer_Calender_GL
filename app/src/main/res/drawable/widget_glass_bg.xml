<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted dark-glass card. Semi-transparent so the launcher wallpaper bleeds
     through for a real glassmorphism effect, while staying dark enough that the
     cream/gold text stays legible on any wallpaper. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="22dp" />
    <gradient
        android:angle="135"
        android:startColor="#E61D1726"
        android:endColor="#C2140F1A" />
    <stroke
        android:width="1dp"
        android:color="#26FFFFFF" />
</shape>

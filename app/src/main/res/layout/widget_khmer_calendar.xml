<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp"
    android:gravity="center_vertical">

    <!-- Header row: label + moon phase -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ប្រតិទិនចន្ទគតិខ្មែរ"
            android:textColor="#C7B38E"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:letterSpacing="0.05"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_moon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌕"
            android:textSize="22sp" />
    </LinearLayout>

    <!-- Gregorian date -->
    <TextView
        android:id="@+id/widget_greg_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="ថ្ងៃ"
        android:textColor="#F2E8C6"
        android:textSize="16sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textStyle="bold" />

    <!-- Lunar date -->
    <TextView
        android:id="@+id/widget_lunar_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="ថ្ងៃចន្ទគតិ"
        android:textColor="#C8973A"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textStyle="bold" />

    <!-- Chips row: BE + zodiac -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_be"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip_background"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="ព.ស."
            android:textColor="#C8973A"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_zodiac"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text=""
            android:textColor="#E8768A"
            android:textSize="10sp"
            android:gravity="center_vertical"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Holiday / auspicious note -->
    <TextView
        android:id="@+id/widget_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textColor="#7BA7BC"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone" />
</LinearLayout>

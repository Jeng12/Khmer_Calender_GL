<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Left day panel -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.42"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_m_dow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#C7B38E"
                android:textSize="11sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_m_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="២"
                android:textColor="#F2E8C6"
                android:textSize="44sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_m_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="មិថុនា"
                android:textColor="#F5EDD8"
                android:textSize="13sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_m_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="២០២៦"
                android:textColor="#C7B38E"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_m_moon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌕"
                    android:textSize="22sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_m_lunar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#C8973A"
                        android:textSize="10sp"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/widget_m_zodiac"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#C7B38E"
                        android:textSize="9sp"
                        android:maxLines="1" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="#33C8973A" />

        <!-- Right: mini grid + upcoming events -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.58"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/widget_m_weekdays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/widget_m_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="vertical" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:background="#33C8973A" />

            <TextView
                android:id="@+id/widget_m_events_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="ព្រឹត្តិការណ៍ខាងមុខ"
                android:textColor="#C8973A"
                android:textSize="10sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/widget_m_events"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="2dp"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
